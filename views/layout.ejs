<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script type="module" src="/javascripts/serviceWorker.js"></script>
    <script type="module" src="/javascripts/flashMessage.js"></script>
    <script type="module" src="/javascripts/navigation.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel='stylesheet' href='/stylesheets/style.css'/>
    <link rel="manifest" href="/manifest.json">
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh; margin: 0;">
<div class="content-wrap" style="flex: 1;">
    <%- include('partials/header') %>
    <main>
        <div class="content">
            <div id="offline-message-container" class="alert alert-danger text-center" role="alert"
                 style="display: none;">
                You are currently offline!
            </div>

            <div id="flash-message-container"></div>

            <div class="card" style="padding: 2.5%; min-height: 60vh;">
                <%- body; %>
            </div>
        </div>
    </main>
</div>
<%- include('partials/footer') %>
</body>
</html>
